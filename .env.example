DATABASE_URL=postgres://briotap:briotap@127.0.0.1:55432/briotap

# Compose paths and local endpoints.
BRIOTAP_DATA_DIR=./data
APP_PORT=3000
POSTGRES_PORT=55432
ORIGIN=http://localhost:3000

# Shared pkg.go.dev budget: background may use total minus reserve.
PKG_REQUESTS_PER_SECOND=40
PKG_RESERVED_REQUESTS_PER_SECOND=10

# On the NAS use APP_PORT=3042 and put PostgreSQL on the large data disk.
# POSTGRES_DATA_DIR=/absolute/path/on/data-disk/postgres
# Only trust this header when every request passes through the controlled tunnel.
ADDRESS_HEADER=
# Optional: COMPOSE_PROFILES=public
# CLOUDFLARED_TOKEN_FILE=/etc/briotap/cloudflared-token
