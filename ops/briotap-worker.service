[Unit]
Description=Discover and enrich Go modules for briotap
Wants=network-online.target
After=network-online.target
Conflicts=briotap-enrich.service briotap-nas-seed.service

[Service]
Type=simple
ExecStart=/usr/bin/flock --nonblock --no-fork /srv/dev-disk-by-uuid-5aef6871-c178-4eba-a09c-22b258f91e50/briotap/enrichment-worker.lock /usr/local/bin/node /opt/briotap/worker.mjs /srv/dev-disk-by-uuid-5aef6871-c178-4eba-a09c-22b258f91e50/briotap
Restart=on-failure
RestartSec=30s
TimeoutStopSec=45s

[Install]
WantedBy=multi-user.target
